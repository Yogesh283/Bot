# Local defaults for Docker Desktop. Copy this file to .env before starting.
# Replace every secret before this machine is reachable by anyone else.

POSTGRES_USER=mt5
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=mt5platform

DATABASE_URL=postgresql+psycopg://mt5:change-me-local-only@127.0.0.1:5432/mt5platform
# XAMPP MySQL is ready as a second database named mt5platform.
# The running app stays on DATABASE_URL so current accounts are kept.
# To move onto XAMPP, set DATABASE_URL to the MySQL URL below and restart the API.
# MYSQL_DATABASE_URL=mysql+pymysql://mt5:change-me-local-only@127.0.0.1:3306/mt5platform
REDIS_URL=redis://127.0.0.1:6379/0

# Generate a real value with:
# py -3.14 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# false is required for http://localhost. Use true behind HTTPS.
COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001
APP_PUBLIC_URL=http://127.0.0.1:3000
# Public address of the trading screen. Email links use this.
USER_PANEL_URL=http://127.0.0.1:3000
# Admin desk is ADMIN_DOMAIN plus /ADMIN_PATH, for example http://127.0.0.1:3001/xyz26.
ADMIN_DOMAIN=http://127.0.0.1:3001
ADMIN_PATH=xyz26
API_PROXY_TARGET=http://127.0.0.1:8000
ENVIRONMENT=development
# true blocks sign-in until the email link is opened. false is only for a local test.
REQUIRE_EMAIL_VERIFICATION=true

# Encrypts the MT5 password at rest. Generate with:
# py -3.14 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Put the same value in the Windows agent environment. Leave blank to derive it from JWT_SECRET.
MT5_CREDENTIAL_KEY=

# Admin signals older than this many seconds are expired and are not executed.
SIGNAL_MAX_AGE_SECONDS=60
